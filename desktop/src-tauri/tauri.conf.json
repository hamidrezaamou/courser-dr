{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mramo",
  "mainBinaryName": "Mramo",
  "version": "0.1.0",
  "identifier": "ir.mramo.archive",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "آرشیو بیمار",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "mramo",
    "shortDescription": "ایستگاه کاری آرشیو بیمار",
    "longDescription": "نسخه ویندوز آرشیو بیمار برای منشی و پزشک. ورود با همان حساب وب، کار آفلاین با همگام‌سازی به mramo.ir",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    }
  }
}
